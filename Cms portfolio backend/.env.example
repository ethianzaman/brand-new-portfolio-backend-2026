# Copy to .env and fill in. Never commit .env.

# ── Server ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Browser origins allowed by CORS, comma-separated. The first one also receives
# the revalidation call after a content change.
FRONTEND_URL=http://localhost:3000
# Number of proxies in front of this server. Leave empty when there are none.
TRUST_PROXY=

# ── Database ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/portfolio

# ── Auth ─────────────────────────────────────────────────────────────────
# Required in production: `openssl rand -base64 48`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# First Super Admin, created on start if the account doesn't exist yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Frontend revalidation ────────────────────────────────────────────────
# Must match REVALIDATE_SECRET in the frontend's .env.local.
REVALIDATE_SECRET=

# ── Cloudinary (uploads) ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (contact form) ─────────────────────────────────────────────────
# Optional: force one provider, otherwise whichever is configured is used.
MAIL_PROVIDER=
RESEND_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=
MAIL_FROM_NAME=
ADMIN_NOTIFICATION_EMAIL=

# ── Optional ─────────────────────────────────────────────────────────────
# Seconds the API keeps a public response in memory.
CACHE_TTL_SECONDS=30
